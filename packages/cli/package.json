{
  "name": "@xctrace-analyzer/cli",
  "version": "0.1.7",
  "description": "CLI for Xcode Instruments trace recording and analysis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xctrace-analyzer": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesrochabrun/XcodeTraceMCP.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jamesrochabrun/XcodeTraceMCP/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/jamesrochabrun/XcodeTraceMCP/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --tsBuildInfoFile typecheck.tsbuildinfo",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "xcode",
    "instruments",
    "xctrace",
    "performance",
    "cli"
  ],
  "author": "James Rochabrun",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xctrace-analyzer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
