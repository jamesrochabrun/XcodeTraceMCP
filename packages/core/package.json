{
  "name": "@xctrace-analyzer/core",
  "version": "0.1.0",
  "description": "Core analysis library for Xcode Instruments traces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": ["xcode", "instruments", "xctrace", "performance", "analysis"],
  "author": "James Rochabrun",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
