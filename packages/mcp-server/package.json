{
  "name": "@xctrace-analyzer/mcp-server",
  "version": "0.1.5",
  "description": "MCP server for Xcode Instruments trace analysis",
  "mcpName": "io.github.jamesrochabrun/xctrace-analyzer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "xctrace-analyzer-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesrochabrun/XcodeTraceMCP.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/jamesrochabrun/XcodeTraceMCP/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/jamesrochabrun/XcodeTraceMCP/issues"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prepack": "node ../../scripts/sync-mcp-skill-assets.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit --tsBuildInfoFile typecheck.tsbuildinfo",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "xcode",
    "instruments",
    "mcp",
    "ai",
    "claude"
  ],
  "author": "James Rochabrun",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@xctrace-analyzer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}